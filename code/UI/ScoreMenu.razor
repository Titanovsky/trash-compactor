@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

@if ( !IsOpen )
	return;

<root>
	<div class="scoreboard">
		@if ( Networking.IsHost )
		{
			<div class="scoreboard-actions">
				<button class="@ForceVoteButtonClass" onclick=@ForceMapVote>
					FORCE MAP VOTE
				</button>
			</div>
		}

		<div class="scoreboard-list">
			@{
				var groups = TeamGroups;
			}

			@for ( var i = 0; i < groups.Count; i++ )
			{
				var group = groups[i];
				var role = group.Role;
				var rows = group.Rows;

				<div class="team-section @(i > 0 ? "separated" : "")">
					<div class="team-header">
						<div class="team-title" style="color: @RoleColor( role )">@TeamName( role )</div>
					</div>

					@foreach ( var row in rows )
					{
						if ( row.IsBot )
						{
							<div class="scoreboard-row bot @(row.IsDead ? "dead" : "")">
								<div class="avatar bot"></div>
								<div class="player-name">@row.Name</div>
								<div class="player-ping">BOT</div>
							</div>
						}
						else
						{
							<div class="scoreboard-row">
								<img class="avatar" src="avatar:@row.SteamId" onclick=@( () => OpenProfile( row.User ) ) />
								<div class="player-name">@row.Name</div>
								<div class="player-ping">@row.PingText</div>
							</div>
						}
					}
				</div>
			}
		</div>
	</div>
</root>

@code
{
	private bool IsOpen => Input.Down( "Score" );
	private bool CanForceMapVote => GameManager.Instance?.CanRequestMapVote == true;
	private string ForceVoteButtonClass => CanForceMapVote ? "force-vote-button" : "force-vote-button disabled";
	private static readonly RoleTrashCompactor[] TeamRoles =
	[
		RoleTrashCompactor.Trashman,
		RoleTrashCompactor.Survival,
		RoleTrashCompactor.Spectator
	];

	private List<TeamGroup> TeamGroups => TeamRoles
		.Select( role => new TeamGroup
		{
			Role = role,
			Rows = RowsForRole( role ).ToList()
		} )
		.Where( group => group.Rows.Count > 0 )
		.ToList();

	private IEnumerable<ScoreRow> RowsForRole( RoleTrashCompactor role )
	{
		var rows = Connection.All
			.Where( user => GetRole( user ) == role )
			.Select( user => new ScoreRow
			{
				User = user,
				Name = user.DisplayName,
				SteamId = user.SteamId,
				PingText = user.Ping.ToString(),
				IsBot = false,
				IsDead = false
			} )
			.ToList();

		if ( role == RoleTrashCompactor.Survival )
		{
			rows.AddRange( NpcRows() );
		}

		return rows;
	}

	private IEnumerable<ScoreRow> NpcRows()
	{
		return NpcSurvivor.All
			.Where( npc => npc.IsValid() )
			.Select( npc => new ScoreRow
			{
				User = null,
				Name = npc.GetName(),
				SteamId = 0,
				PingText = "BOT",
				IsBot = true,
				IsDead = !npc.IsAlive
			} );
	}

	private Player FindPlayer( Connection user )
	{
		return Scene.GetAllComponents<Player>()
			.FirstOrDefault( player => player.IsValid() && player.GameObject.Network.Owner == user );
	}

	private RoleTrashCompactor GetRole( Connection user )
	{
		return FindPlayer( user )?.RoleEnum ?? RoleTrashCompactor.Spectator;
	}

	private string TeamName( RoleTrashCompactor role )
	{
		return role switch
		{
			RoleTrashCompactor.Trashman => "Trashman",
			RoleTrashCompactor.Spectator => "Spectator",
			_ => "Survivor"
		};
	}

	private string RoleName( RoleTrashCompactor role )
	{
		return role switch
		{
			RoleTrashCompactor.Trashman => "Trashman",
			RoleTrashCompactor.Spectator => "Spectator",
			_ => "Survivor"
		};
	}

	private string RoleColor( RoleTrashCompactor role )
	{
		return role switch
		{
			RoleTrashCompactor.Trashman => "#df5151",
			RoleTrashCompactor.Spectator => "#dfa151",
			_ => "#5191df"
		};
	}

	private void OpenProfile( Connection user )
	{
		if ( user is null )
			return;

		Game.Overlay.ShowPlayer( user.SteamId );
	}

	private void ForceMapVote()
	{
		if ( !CanForceMapVote )
			return;

		GameManager.Instance?.RequestMapVote();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( Networking.IsHost );
		hash.Add( CanForceMapVote );

		if ( !IsOpen )
			return hash.ToHashCode();

		hash.Add( RealTime.Now.CeilToInt() );
		hash.Add( Connection.All.Count() );

		foreach ( var user in Connection.All )
		{
			hash.Add( user.SteamId );
			hash.Add( user.DisplayName );
			hash.Add( user.Ping );
			hash.Add( GetRole( user ) );
		}

		hash.Add( NpcSurvivor.All.Count );

		foreach ( var npc in NpcSurvivor.All )
		{
			if ( !npc.IsValid() )
				continue;

			hash.Add( npc.GetName() );
			hash.Add( npc.IsAlive );
		}

		return hash.ToHashCode();
	}

	private sealed class TeamGroup
	{
		public RoleTrashCompactor Role { get; set; }
		public List<ScoreRow> Rows { get; set; }
	}

	private sealed class ScoreRow
	{
		public Connection User { get; set; }
		public string Name { get; set; }
		public ulong SteamId { get; set; }
		public string PingText { get; set; } = "";
		public bool IsBot { get; set; }
		public bool IsDead { get; set; }
	}
}
