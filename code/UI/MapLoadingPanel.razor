@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root class="@PanelState">
	@if ( IsMapLoading )
	{
		<div class="loading-title">Map Loading...</div>
	}
	else if ( IsWaitingForHost )
	{
		<div class="loading-title">Waiting the host...</div>
	}
</root>

@code
{
	private GameManager Manager => GameManager.Instance;

	private bool IsMapLoading => Manager?.IsLocalMapLoadedForCurrentRevision != true;
	private bool IsWaitingForHost => !Networking.IsHost
		&& !IsMapLoading
		&& Manager?.IsHostReadyForCurrentMap != true;
	private string PanelState => IsMapLoading
		? "loading"
		: IsWaitingForHost ? "waiting" : "loaded";

	protected override int BuildHash() => System.HashCode.Combine( PanelState );
}
